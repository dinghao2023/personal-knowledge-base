# ===== LLM（OpenAI 兼容 Chat Completions）=====
# 支持 DeepSeek / 智谱 GLM / 通义千问 / 豆包 / OpenAI 等任意兼容服务
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ===== Embedding =====
# provider: api（调用远端向量模型，轻量，推荐） | local（本地 bge-small-zh，需装 sentence-transformers）
EMBEDDING_PROVIDER=api
# API 提供方必须支持 OpenAI 兼容的 /embeddings，例如：
#   智谱:  https://open.bigmodel.cn/api/paas/v4  模型: embedding-3
#   通义:  https://dashscope.aliyuncs.com/compatible-mode/v1  模型: text-embedding-v3
#   SiliconFlow: https://api.siliconflow.cn/v1  模型: BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
# local 模式使用的模型名（HuggingFace）
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ===== 存储 =====
CHROMA_DIR=./chroma_db
DOCS_DIR=./docs
COLLECTION_NAME=knyx

# ===== 分块与检索 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SIMILARITY_THRESHOLD=0.5
HISTORY_TURNS=4
